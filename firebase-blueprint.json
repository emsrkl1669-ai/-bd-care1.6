  "firestore": {
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminMember" },
      "description": "Authorized staff members for BD-Care foundation operations"
    },
    "/patients/{patientId}": {
      "schema": { "$ref": "#/entities/PatientRecord" },
      "description": "Patient records (แบบ สค.04) with PII restricted to owner or foundation admins"
    },
    "/patients/{patientId}/deliveries/{deliveryId}": {
      "schema": { "$ref": "#/entities/PatientDelivery" },
      "description": "Monthly supply deliveries for a patient"
    },
    "/patients/{patientId}/media/{mediaId}": {
      "schema": { "$ref": "#/entities/MediaAttachment" },
      "description": "Photos and uploaded documents belonging to a patient"
    },
    "/funerals/{funeralId}": {
      "schema": { "$ref": "#/entities/FuneralRecord" },
      "description": "Funeral assistance case records (แบบ ฌศ.01)"
    },
    "/funerals/{funeralId}/media/{mediaId}": {
      "schema": { "$ref": "#/entities/MediaAttachment" },
      "description": "Uploaded 7-item funeral verification documents"
    },
    "/donations/{donationId}": {
      "schema": { "$ref": "#/entities/DonationRecord" },
      "description": "Donation supply distribution records (แบบ บจ.01)"
    },
    "/donations/{donationId}/media/{mediaId}": {
      "schema": { "$ref": "#/entities/MediaAttachment" },
      "description": "Photos and uploaded supporting documents for a donation record"
    }
  }
}
