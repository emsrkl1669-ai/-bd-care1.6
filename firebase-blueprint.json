{
  "entities": {
    "AdminMember": {
      "title": "AdminMember",
      "description": "Authorized foundation officer or administrator granted access to BD-Care records",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "maxLength": 200
        },
        "role": {
          "type": "string",
          "enum": ["officer", "approver", "president", "superadmin"]
        },
        "serverCreatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "serverUpdatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "role", "serverCreatedAt", "serverUpdatedAt"]
    },
    "PatientRecord": {
      "title": "PatientRecord",
      "description": "Core patient survey and relief assistance record (แบบ สค.04) organized into validated sub-maps without large binary media arrays",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorizedEmails": {
          "type": "array",
          "description": "Verified staff emails authorized to read/write this shared record"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "status": {
          "type": "string",
          "enum": ["active", "pending", "deceased", "moved", "rejected"]
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "mobilityLevel": {
          "type": "string",
          "enum": ["bedridden", "semi_bedridden", "can_walk"]
        },
        "profile": {
          "type": "object",
          "description": "Personal identity, admissionDate, statusReason, statusHistory, and caregiver contact info"
        },
        "location": {
          "type": "object",
          "description": "idAddress, currentAddress, isSameAddress, GPS coordinates, landmarkNote, googleMapsUrl, and qrCodeDataUrl"
        },
        "medical": {
          "type": "object",
          "description": "chronicDiseases, symptomsDetail, disabilityCard, and specialNeeds"
        },
        "householdEconomy": {
          "type": "object",
          "description": "Household headcounts, monthly income breakdown, itemized expenses, net income, and economicNote"
        },
        "assistancePlan": {
          "type": "object",
          "description": "Approved monthly cash, diaper, rice, water, and special supply quotas"
        },
        "assessment": {
          "type": "object",
          "description": "vulnerabilityScore, vulnerabilityLevel, dimensionScores, socialWorkerOpinion, aiSuggestions, and signatories"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        },
        "serverCreatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "serverUpdatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerUid",
        "code",
        "status",
        "fullName",
        "mobilityLevel",
        "createdAt",
        "updatedAt",
        "serverCreatedAt",
        "serverUpdatedAt"
      ]
    },
    "PatientDelivery": {
      "title": "PatientDelivery",
      "description": "Monthly supply delivery record stored in patient subcollection",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "patientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorizedEmails": {
          "type": "array"
        },
        "deliveryDate": {
          "type": "string",
          "maxLength": 32
        },
        "monthYearLabel": {
          "type": "string",
          "maxLength": 80
        },
        "cashAmount": {
          "type": "number"
        },
        "cashGiven": {
          "type": "boolean"
        },
        "diaperSize": {
          "type": "string",
          "enum": ["S", "M", "L", "XL", "XXL", "NONE"]
        },
        "diaperPacks": {
          "type": "number"
        },
        "ricePacks": {
          "type": "number"
        },
        "waterPacks": {
          "type": "number"
        },
        "waterSize": {
          "type": "string",
          "enum": ["1.5L", "600ML", "NONE"]
        },
        "otherItems": {
          "type": "string",
          "maxLength": 500
        },
        "receivedBy": {
          "type": "string",
          "maxLength": 200
        },
        "recipientRelation": {
          "type": "string",
          "maxLength": 100
        },
        "officerName": {
          "type": "string",
          "maxLength": 200
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "serverCreatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "serverUpdatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "patientId", "ownerUid", "deliveryDate", "receivedBy", "serverCreatedAt", "serverUpdatedAt"]
    },
    "MediaAttachment": {
      "title": "MediaAttachment",
      "description": "Single photo or uploaded document stored in a subcollection to keep each Firestore document safely under 1 MiB",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "parentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorizedEmails": {
          "type": "array"
        },
        "kind": {
          "type": "string",
          "enum": ["photo", "document"]
        },
        "category": {
          "type": "string",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "fileName": {
          "type": "string",
          "maxLength": 255
        },
        "fileType": {
          "type": "string",
          "maxLength": 120
        },
        "dataUrl": {
          "type": "string",
          "maxLength": 850000
        },
        "fileSize": {
          "type": "number"
        },
        "caption": {
          "type": "string",
          "maxLength": 500
        },
        "timestamp": {
          "type": "string",
          "maxLength": 100
        },
        "uploadDate": {
          "type": "string",
          "maxLength": 64
        },
        "serverCreatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "serverUpdatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "parentId", "ownerUid", "kind", "dataUrl", "serverCreatedAt", "serverUpdatedAt"]
    },
    "FuneralRecord": {
      "title": "FuneralRecord",
      "description": "Funeral assistance application record (แบบ ฌศ.01) organized into validated sub-maps without inline attachment binaries",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorizedEmails": {
          "type": "array"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "applicationDate": {
          "type": "string",
          "maxLength": 32
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "completed", "rejected"]
        },
        "statusNote": {
          "type": "string",
          "maxLength": 1000
        },
        "deceasedName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "applicantName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "deceasedInfo": {
          "type": "object",
          "description": "Deceased identity, age, death timestamp, causeOfDeath, deathPlace, and registered address"
        },
        "applicantInfo": {
          "type": "object",
          "description": "Applicant contact, relation, address, and poverty/assistance reason"
        },
        "cremationAid": {
          "type": "object",
          "description": "Temple, cremation schedule, assistanceAmount, coffin/transport/shroud flags, and otherItems"
        },
        "signatories": {
          "type": "object",
          "description": "Officer and approver names, positions, IDs, and approvalDate"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        },
        "serverCreatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "serverUpdatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerUid",
        "code",
        "status",
        "deceasedName",
        "applicantName",
        "createdAt",
        "updatedAt",
        "serverCreatedAt",
        "serverUpdatedAt"
      ]
    },
    "DonationRecord": {
      "title": "DonationRecord",
      "description": "Donation supply distribution record (แบบ บจ.01) organized into validated sub-maps without inline attachment binaries",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorizedEmails": {
          "type": "array"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "distributionDate": {
          "type": "string",
          "maxLength": 32
        },
        "status": {
          "type": "string",
          "enum": ["completed", "pending", "cancelled"]
        },
        "recipientType": {
          "type": "string",
          "enum": ["individual", "government"]
        },
        "recipientInfo": {
          "type": "object",
          "description": "Individual citizen or government agency details, contact info, and request reason"
        },
        "itemsSummary": {
          "type": "object",
          "description": "Distributed water, dry food, rice, diapers, otherItems list, and notes"
        },
        "handoverAndSignatories": {
          "type": "object",
          "description": "Handover location, delivery method, officer, and approver signatory details"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        },
        "serverCreatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "serverUpdatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerUid",
        "code",
        "status",
        "recipientType",
        "createdAt",
        "updatedAt",
        "serverCreatedAt",
        "serverUpdatedAt"
      ]
    },
    "WorkspaceSettings": {
      "title": "WorkspaceSettings",
      "description": "Shared foundation workspace access allowlist managed by Super Admin",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "authorizedEmails": {
          "type": "array"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        },
        "updatedBy": {
          "type": "string",
          "maxLength": 200
        },
        "serverCreatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "serverUpdatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "authorizedEmails", "updatedAt", "serverCreatedAt", "serverUpdatedAt"]
    },
    "DeliveryPlanSettings": {
      "title": "DeliveryPlanSettings",
      "description": "Shared monthly delivery plan parameters (rice price per bag, custom rice bag count, delivery month)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorizedEmails": {
          "type": "array"
        },
        "ricePricePerBag": {
          "type": "number"
        },
        "customRiceCount": {
          "type": "number"
        },
        "currentMonth": {
          "type": "string",
          "maxLength": 100
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        },
        "serverCreatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "serverUpdatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerUid", "ricePricePerBag", "currentMonth", "updatedAt", "serverCreatedAt", "serverUpdatedAt"]
    },
    "AccessRequest": {
      "title": "AccessRequest",
      "description": "Cross-device team access request submitted by a signed-in Google user for Super Admin approval",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "maxLength": 200
        },
        "note": {
          "type": "string",
          "maxLength": 300
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        },
        "reviewedBy": {
          "type": "string",
          "maxLength": 200
        },
        "serverCreatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "serverUpdatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "status", "serverCreatedAt", "serverUpdatedAt"]
    }
  },
  "firestore": {
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminMember" },
      "description": "Authorized staff members for BD-Care foundation operations"
    },
    "/access_requests/{uid}": {
      "schema": { "$ref": "#/entities/AccessRequest" },
      "description": "Pending and reviewed cross-device access requests from other Google accounts"
    },
    "/settings/workspace": {
      "schema": { "$ref": "#/entities/WorkspaceSettings" },
      "description": "Authorized staff email allowlist for cross-device collaboration"
    },
    "/settings/delivery_plan": {
      "schema": { "$ref": "#/entities/DeliveryPlanSettings" },
      "description": "Synchronized delivery plan rice bag count, price per bag, and delivery month"
    },
    "/patients/{patientId}": {
      "schema": { "$ref": "#/entities/PatientRecord" },
      "description": "Patient records (แบบ สค.04) with PII restricted to owner or foundation admins"
    },
    "/patients/{patientId}/deliveries/{deliveryId}": {
      "schema": { "$ref": "#/entities/PatientDelivery" },
      "description": "Monthly supply deliveries for a patient"
    },
    "/patients/{patientId}/media/{mediaId}": {
      "schema": { "$ref": "#/entities/MediaAttachment" },
      "description": "Photos and uploaded documents belonging to a patient"
    },
    "/funerals/{funeralId}": {
      "schema": { "$ref": "#/entities/FuneralRecord" },
      "description": "Funeral assistance case records (แบบ ฌศ.01)"
    },
    "/funerals/{funeralId}/media/{mediaId}": {
      "schema": { "$ref": "#/entities/MediaAttachment" },
      "description": "Uploaded 7-item funeral verification documents"
    },
    "/donations/{donationId}": {
      "schema": { "$ref": "#/entities/DonationRecord" },
      "description": "Donation supply distribution records (แบบ บจ.01)"
    },
    "/donations/{donationId}/media/{mediaId}": {
      "schema": { "$ref": "#/entities/MediaAttachment" },
      "description": "Photos and uploaded supporting documents for a donation record"
    }
  }
}
