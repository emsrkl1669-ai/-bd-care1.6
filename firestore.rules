rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Security Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null &&
        request.auth.token.email is string &&
        request.auth.token.email.size() > 0;
    }

    function hasSuperAdminEmail() {
      return request.auth.token.email.lower() == 'kitphiphat03@bdcare.foundation';
    }

    function isSuperAdmin() {
      return isSignedIn() && hasSuperAdminEmail();
    }

    function hasBuiltInStaffEmail() {
      return request.auth.token.email.lower() in [
        'kitphiphat03@bdcare.foundation',
        'aleena@bdcare.foundation',
        'muanruethai@bdcare.foundation',
        'sataporn@bdcare.foundation',
        'paiwong@bdcare.foundation'
      ];
    }

    function isBuiltInStaffEmail() {
      return isSignedIn() && hasBuiltInStaffEmail();
    }

    function isStaffAdmin() {
      return isSignedIn() && (
        hasBuiltInStaffEmail() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isAuthorizedStaff() {
      return isStaffAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/settings/workspace) &&
        isSharedTeamMember(get(/databases/$(database)/documents/settings/workspace).data)
      );
    }

    function isOwner(data) {
      return isSignedIn() && data.ownerUid == request.auth.uid;
    }

    function isValidEmailList(data) {
      return !('authorizedEmails' in data) || (
        data.authorizedEmails is list &&
        data.authorizedEmails.size() <= 50 &&
        (data.authorizedEmails.size() == 0 || data.authorizedEmails[0] is string)
      );
    }

    function isSharedTeamMember(data) {
      return isSignedIn() &&
        ('authorizedEmails' in data) &&
        data.authorizedEmails is list &&
        (
          request.auth.token.email in data.authorizedEmails ||
          request.auth.token.email.lower() in data.authorizedEmails
        );
    }

    function isStr(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isOptStr(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isOptNum(data, field) {
      return !(field in data) || (data[field] is int || data[field] is float);
    }

    function isOptBool(data, field) {
      return !(field in data) || data[field] is bool;
    }

    // 3. Healthcheck probe (authenticated connectivity verification)
    match /test/{docId} {
      allow get: if isSignedIn();
    }

    // 4. Admin Directory Collection
    function isValidAdminMember(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'role', 'serverCreatedAt', 'serverUpdatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'serverCreatedAt', 'serverUpdatedAt']) &&
        isValidId(data.uid) &&
        data.uid == uid &&
        isStr(data.email, 200) &&
        isOptStr(data, 'displayName', 200) &&
        data.role in ['officer', 'approver', 'president', 'superadmin'] &&
        data.serverCreatedAt is timestamp &&
        data.serverUpdatedAt is timestamp;
    }

    match /admins/{uid} {
      allow get: if isValidId(uid) && isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin() &&
        isValidId(uid) &&
        isValidAdminMember(incoming(), uid) &&
        incoming().serverCreatedAt == request.time &&
        incoming().serverUpdatedAt == request.time;
      allow update: if isSuperAdmin() &&
        isValidId(uid) &&
        isValidAdminMember(incoming(), uid) &&
        incoming().uid == existing().uid &&
        incoming().serverCreatedAt == existing().serverCreatedAt &&
        incoming().serverUpdatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'role', 'serverUpdatedAt']);
      allow delete: if isSuperAdmin() && isValidId(uid);
    }

    // 4A. Cross-Device Access Requests
    function isValidAccessRequest(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'status', 'serverCreatedAt', 'serverUpdatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'note', 'status', 'reviewedBy', 'serverCreatedAt', 'serverUpdatedAt']) &&
        isValidId(data.uid) &&
        data.uid == uid &&
        isStr(data.email, 200) &&
        isOptStr(data, 'displayName', 200) &&
        isOptStr(data, 'note', 300) &&
        data.status in ['pending', 'approved', 'rejected'] &&
        isOptStr(data, 'reviewedBy', 200) &&
        data.serverCreatedAt is timestamp &&
        data.serverUpdatedAt is timestamp;
    }

    match /access_requests/{uid} {
      allow get: if isValidId(uid) && isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isSignedIn() &&
        isValidId(uid) &&
        request.auth.uid == uid &&
        isValidAccessRequest(incoming(), uid) &&
        incoming().email.lower() == request.auth.token.email.lower() &&
        incoming().status == 'pending' &&
        incoming().serverCreatedAt == request.time &&
        incoming().serverUpdatedAt == request.time;
      allow update: if isSignedIn() &&
        isValidId(uid) &&
        isValidAccessRequest(incoming(), uid) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().serverCreatedAt == existing().serverCreatedAt &&
        incoming().serverUpdatedAt == request.time &&
        (
          (
            isSuperAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedBy', 'serverUpdatedAt'])
          ) ||
          (
            request.auth.uid == uid &&
            incoming().status == 'pending' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'note', 'status', 'serverUpdatedAt'])
          )
        );
      allow delete: if isValidId(uid) && (isSuperAdmin() || (isSignedIn() && request.auth.uid == uid));
    }

    // 4B. Shared Workspace & Delivery Plan Settings
    function isValidWorkspaceSettings(data) {
      return data.keys().hasAll(['id', 'authorizedEmails', 'updatedAt', 'serverCreatedAt', 'serverUpdatedAt']) &&
        data.keys().hasOnly(['id', 'authorizedEmails', 'updatedAt', 'updatedBy', 'serverCreatedAt', 'serverUpdatedAt']) &&
        data.id == 'workspace' &&
        data.authorizedEmails is list &&
        data.authorizedEmails.size() <= 50 &&
        (data.authorizedEmails.size() == 0 || data.authorizedEmails[0] is string) &&
        isStr(data.updatedAt, 64) &&
        isOptStr(data, 'updatedBy', 200) &&
        data.serverCreatedAt is timestamp &&
        data.serverUpdatedAt is timestamp;
    }

    match /settings/workspace {
      allow get: if isSuperAdmin() || isBuiltInStaffEmail() || isStaffAdmin() || (resource != null && isSharedTeamMember(existing()));
      allow create: if isSuperAdmin() &&
        isValidWorkspaceSettings(incoming()) &&
        incoming().serverCreatedAt == request.time &&
        incoming().serverUpdatedAt == request.time;
      allow update: if isSuperAdmin() &&
        isValidWorkspaceSettings(incoming()) &&
        incoming().id == existing().id &&
        incoming().serverCreatedAt == existing().serverCreatedAt &&
        incoming().serverUpdatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['authorizedEmails', 'updatedAt', 'updatedBy', 'serverUpdatedAt']);
      allow delete: if isSuperAdmin();
    }

    function isValidDeliveryPlanSettings(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'ricePricePerBag', 'currentMonth', 'updatedAt', 'serverCreatedAt', 'serverUpdatedAt']) &&
        data.keys().hasOnly(['id', 'ownerUid', 'authorizedEmails', 'ricePricePerBag', 'customRiceCount', 'currentMonth', 'updatedAt', 'serverCreatedAt', 'serverUpdatedAt']) &&
        data.id == 'delivery_plan' &&
        isValidId(data.ownerUid) &&
        isValidEmailList(data) &&
        (data.ricePricePerBag is int || data.ricePricePerBag is float) &&
        (!('customRiceCount' in data) || data.customRiceCount == null || data.customRiceCount is int || data.customRiceCount is float) &&
        isStr(data.currentMonth, 100) &&
        isStr(data.updatedAt, 64) &&
        data.serverCreatedAt is timestamp &&
        data.serverUpdatedAt is timestamp;
    }

    match /settings/delivery_plan {
      allow get: if isSuperAdmin() || isStaffAdmin() || (resource == null && isAuthorizedStaff()) || (resource != null && (isOwner(existing()) || isSharedTeamMember(existing())));
      allow create: if isSignedIn() &&
        isValidDeliveryPlanSettings(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().serverCreatedAt == request.time &&
        incoming().serverUpdatedAt == request.time &&
        (
          isSuperAdmin() ||
          isStaffAdmin() ||
          (
            exists(/databases/$(database)/documents/settings/workspace) &&
            isSharedTeamMember(get(/databases/$(database)/documents/settings/workspace).data)
          )
        );
      allow update: if isSignedIn() &&
        isValidDeliveryPlanSettings(incoming()) &&
        incoming().serverUpdatedAt == request.time &&
        (
          isSuperAdmin() ||
          (
            (!('id' in existing()) || incoming().id == existing().id) &&
            (!('ownerUid' in existing()) ? incoming().ownerUid == request.auth.uid : incoming().ownerUid == existing().ownerUid) &&
            (!('serverCreatedAt' in existing()) || existing().serverCreatedAt == null || !(existing().serverCreatedAt is timestamp) ? incoming().serverCreatedAt == request.time : incoming().serverCreatedAt == existing().serverCreatedAt) &&
            (isStaffAdmin() || isOwner(existing()) || isSharedTeamMember(existing())) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'ricePricePerBag', 'customRiceCount', 'currentMonth', 'updatedAt', 'serverUpdatedAt'
            ])
          )
        );
      allow delete: if isSuperAdmin();
    }

    // 5. Patient Records (แบบ สค.04)
    function isValidPatientRecord(data, patientId) {
      let keys = data.keys().toSet();
      return keys.hasAll([
          'id', 'ownerUid', 'code', 'status', 'fullName',
          'mobilityLevel', 'createdAt', 'updatedAt', 'serverCreatedAt', 'serverUpdatedAt'
        ].toSet()) &&
        keys.hasOnly([
          'id', 'ownerUid', 'authorizedEmails', 'code', 'status', 'fullName', 'mobilityLevel',
          'profile', 'location', 'medical', 'householdEconomy', 'assistancePlan', 'assessment',
          'createdAt', 'updatedAt', 'serverCreatedAt', 'serverUpdatedAt'
        ].toSet()) &&
        isValidId(data.id) &&
        data.id == patientId &&
        isValidId(data.ownerUid) &&
        isValidEmailList(data) &&
        data.code is string && data.code.size() >= 1 && data.code.size() <= 40 &&
        data.status in ['active', 'pending', 'deceased', 'moved', 'rejected'] &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 200 &&
        data.mobilityLevel in ['bedridden', 'semi_bedridden', 'can_walk'] &&
        (!('profile' in data) || (
          data.profile is map &&
          data.profile.keys().size() <= 14 &&
          (!('nationalId' in data.profile) || (data.profile.nationalId is string && data.profile.nationalId.size() <= 30)) &&
          (!('statusReason' in data.profile) || (data.profile.statusReason is string && data.profile.statusReason.size() <= 1000))
        )) &&
        (!('location' in data) || (
          data.location is map &&
          data.location.keys().size() <= 12 &&
          (!('landmarkNote' in data.location) || (data.location.landmarkNote is string && data.location.landmarkNote.size() <= 1000)) &&
          (!('googleMapsUrl' in data.location) || (data.location.googleMapsUrl is string && data.location.googleMapsUrl.size() <= 500)) &&
          (!('qrCodeDataUrl' in data.location) || (data.location.qrCodeDataUrl is string && data.location.qrCodeDataUrl.size() <= 40000))
        )) &&
        (!('medical' in data) || (
          data.medical is map &&
          data.medical.keys().size() <= 6 &&
          (!('chronicDiseases' in data.medical) || (data.medical.chronicDiseases is string && data.medical.chronicDiseases.size() <= 1000)) &&
          (!('symptomsDetail' in data.medical) || (data.medical.symptomsDetail is string && data.medical.symptomsDetail.size() <= 2000)) &&
          (!('specialNeeds' in data.medical) || (data.medical.specialNeeds is list && data.medical.specialNeeds.size() <= 20))
        )) &&
        (!('householdEconomy' in data) || (
          data.householdEconomy is map &&
          data.householdEconomy.keys().size() <= 20 &&
          (!('economicNote' in data.householdEconomy) || (data.householdEconomy.economicNote is string && data.householdEconomy.economicNote.size() <= 1000))
        )) &&
        (!('assistancePlan' in data) || (
          data.assistancePlan is map &&
          data.assistancePlan.keys().size() <= 10 &&
          (!('helpOtherSupplies' in data.assistancePlan) || (data.assistancePlan.helpOtherSupplies is string && data.assistancePlan.helpOtherSupplies.size() <= 500))
        )) &&
        (!('assessment' in data) || (
          data.assessment is map &&
          data.assessment.keys().size() <= 14 &&
          (!('socialWorkerOpinion' in data.assessment) || (data.assessment.socialWorkerOpinion is string && data.assessment.socialWorkerOpinion.size() <= 3000)) &&
          (!('aiSuggestions' in data.assessment) || (data.assessment.aiSuggestions is string && data.assessment.aiSuggestions.size() <= 3000))
        )) &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64 &&
        data.serverCreatedAt is timestamp &&
        data.serverUpdatedAt is timestamp;
    }

    function isValidPatientDelivery(data, patientId, deliveryId) {
      let keys = data.keys().toSet();
      return keys.hasAll([
          'id', 'patientId', 'ownerUid', 'deliveryDate', 'receivedBy', 'serverCreatedAt', 'serverUpdatedAt'
        ].toSet()) &&
        keys.hasOnly([
          'id', 'patientId', 'ownerUid', 'authorizedEmails', 'deliveryDate', 'monthYearLabel',
          'cashAmount', 'cashGiven', 'diaperSize', 'diaperPacks', 'ricePacks',
          'waterPacks', 'waterSize', 'otherItems', 'receivedBy', 'recipientRelation',
          'officerName', 'photoUrl', 'notes', 'serverCreatedAt', 'serverUpdatedAt'
        ].toSet()) &&
        isValidId(data.id) &&
        data.id == deliveryId &&
        isValidId(data.patientId) &&
        data.patientId == patientId &&
        isValidId(data.ownerUid) &&
        isValidEmailList(data) &&
        data.deliveryDate is string && data.deliveryDate.size() <= 32 &&
        (!('monthYearLabel' in data) || (data.monthYearLabel is string && data.monthYearLabel.size() <= 80)) &&
        (!('cashAmount' in data) || data.cashAmount is number) &&
        (!('cashGiven' in data) || data.cashGiven is bool) &&
        (!('diaperSize' in data) || data.diaperSize in ['S', 'M', 'L', 'XL', 'XXL', 'NONE']) &&
        (!('diaperPacks' in data) || data.diaperPacks is number) &&
        (!('ricePacks' in data) || data.ricePacks is number) &&
        (!('waterPacks' in data) || data.waterPacks is number) &&
        (!('waterSize' in data) || data.waterSize in ['1.5L', '600ML', 'NONE']) &&
        (!('otherItems' in data) || (data.otherItems is string && data.otherItems.size() <= 500)) &&
        data.receivedBy is string && data.receivedBy.size() <= 200 &&
        (!('recipientRelation' in data) || (data.recipientRelation is string && data.recipientRelation.size() <= 100)) &&
        (!('officerName' in data) || (data.officerName is string && data.officerName.size() <= 200)) &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500000)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
        data.serverCreatedAt is timestamp &&
        data.serverUpdatedAt is timestamp;
    }

    function isValidMediaAttachment(data, parentId, mediaId) {
      let keys = data.keys().toSet();
      return keys.hasAll([
          'id', 'parentId', 'ownerUid', 'kind', 'dataUrl', 'serverCreatedAt', 'serverUpdatedAt'
        ].toSet()) &&
        keys.hasOnly([
          'id', 'parentId', 'ownerUid', 'authorizedEmails', 'kind', 'category', 'title', 'fileName',
          'fileType', 'dataUrl', 'fileSize', 'caption', 'timestamp', 'uploadDate',
          'serverCreatedAt', 'serverUpdatedAt'
        ].toSet()) &&
        isValidId(data.id) &&
        data.id == mediaId &&
        isValidId(data.parentId) &&
        data.parentId == parentId &&
        isValidId(data.ownerUid) &&
        isValidEmailList(data) &&
        data.kind in ['photo', 'document'] &&
        (!('category' in data) || (data.category is string && data.category.size() <= 64)) &&
        (!('title' in data) || (data.title is string && data.title.size() <= 200)) &&
        (!('fileName' in data) || (data.fileName is string && data.fileName.size() <= 255)) &&
        (!('fileType' in data) || (data.fileType is string && data.fileType.size() <= 120)) &&
        data.dataUrl is string && data.dataUrl.size() <= 850000 &&
        (!('fileSize' in data) || data.fileSize is number) &&
        (!('caption' in data) || (data.caption is string && data.caption.size() <= 500)) &&
        (!('timestamp' in data) || (data.timestamp is string && data.timestamp.size() <= 100)) &&
        (!('uploadDate' in data) || (data.uploadDate is string && data.uploadDate.size() <= 64)) &&
        data.serverCreatedAt is timestamp &&
        data.serverUpdatedAt is timestamp;
    }

    match /patients/{patientId} {
      allow get: if isValidId(patientId) && (isStaffAdmin() || (resource == null && isAuthorizedStaff()) || (resource != null && (isOwner(existing()) || isSharedTeamMember(existing()))));
      allow list: if isSignedIn() && (hasBuiltInStaffEmail() || existing().ownerUid == request.auth.uid || isSharedTeamMember(existing()));
      allow create: if isSignedIn() &&
        isValidId(patientId) &&
        isValidPatientRecord(incoming(), patientId) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().serverCreatedAt == request.time &&
        incoming().serverUpdatedAt == request.time &&
        isAuthorizedStaff();
      allow update: if isSignedIn() &&
        isValidId(patientId) &&
        isValidPatientRecord(incoming(), patientId) &&
        incoming().serverUpdatedAt == request.time &&
        (
          hasSuperAdminEmail() ||
          (
            (!('id' in existing()) || incoming().id == existing().id) &&
            (!('ownerUid' in existing()) ? incoming().ownerUid == request.auth.uid : incoming().ownerUid == existing().ownerUid) &&
            (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
            (!('serverCreatedAt' in existing()) || existing().serverCreatedAt == null || !(existing().serverCreatedAt is timestamp) ? incoming().serverCreatedAt == request.time : incoming().serverCreatedAt == existing().serverCreatedAt) &&
            (isStaffAdmin() || ((isOwner(existing()) || isSharedTeamMember(existing())) && exists(/databases/$(database)/documents/settings/workspace) && isSharedTeamMember(get(/databases/$(database)/documents/settings/workspace).data))) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'code', 'status', 'fullName', 'mobilityLevel',
              'profile', 'location', 'medical', 'householdEconomy', 'assistancePlan', 'assessment',
              'updatedAt', 'serverUpdatedAt'
            ])
          )
        );
      allow delete: if isValidId(patientId) && (isStaffAdmin() || isOwner(existing()) || isSharedTeamMember(existing()));

      match /deliveries/{deliveryId} {
        allow get: if isValidId(patientId) && isValidId(deliveryId) && (
          isStaffAdmin() ||
          (resource == null && isAuthorizedStaff()) ||
          (resource != null && (isOwner(existing()) || isSharedTeamMember(existing())))
        );
        allow list: if isSignedIn() && (isSuperAdmin() || isBuiltInStaffEmail() || existing().ownerUid == request.auth.uid || isSharedTeamMember(existing()));
        allow create: if isSignedIn() &&
          isValidId(patientId) &&
          isValidId(deliveryId) &&
          isValidPatientDelivery(incoming(), patientId, deliveryId) &&
          incoming().ownerUid == request.auth.uid &&
          incoming().serverCreatedAt == request.time &&
          incoming().serverUpdatedAt == request.time &&
          exists(/databases/$(database)/documents/patients/$(patientId)) &&
          (
            isSuperAdmin() ||
            isStaffAdmin() ||
            get(/databases/$(database)/documents/patients/$(patientId)).data.ownerUid == request.auth.uid ||
            isSharedTeamMember(get(/databases/$(database)/documents/patients/$(patientId)).data)
          );
        allow update: if isSignedIn() &&
          isValidId(patientId) &&
          isValidId(deliveryId) &&
          isValidPatientDelivery(incoming(), patientId, deliveryId) &&
          incoming().serverUpdatedAt == request.time &&
          (isSuperAdmin() || (
            (!('id' in existing()) || incoming().id == existing().id) &&
            (!('patientId' in existing()) || incoming().patientId == existing().patientId) &&
            (!('ownerUid' in existing()) ? incoming().ownerUid == request.auth.uid : incoming().ownerUid == existing().ownerUid) &&
            (!('serverCreatedAt' in existing()) || existing().serverCreatedAt == null || !(existing().serverCreatedAt is timestamp) ? incoming().serverCreatedAt == request.time : incoming().serverCreatedAt == existing().serverCreatedAt) &&
            (isStaffAdmin() || isOwner(existing()) || isSharedTeamMember(existing())) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'deliveryDate', 'monthYearLabel', 'cashAmount', 'cashGiven',
              'diaperSize', 'diaperPacks', 'ricePacks', 'waterPacks', 'waterSize',
              'otherItems', 'receivedBy', 'recipientRelation', 'officerName',
              'photoUrl', 'notes', 'serverUpdatedAt'
            ])
          ));
        allow delete: if isValidId(patientId) && isValidId(deliveryId) && (isSuperAdmin() || isStaffAdmin() || isOwner(existing()) || isSharedTeamMember(existing()));
      }

      match /media/{mediaId} {
        allow get: if isValidId(patientId) && isValidId(mediaId) && (
          isStaffAdmin() ||
          (resource == null && isAuthorizedStaff()) ||
          (resource != null && (isOwner(existing()) || isSharedTeamMember(existing())))
        );
        allow list: if isSignedIn() && (isSuperAdmin() || isBuiltInStaffEmail() || existing().ownerUid == request.auth.uid || isSharedTeamMember(existing()));
        allow create: if isSignedIn() &&
          isValidId(patientId) &&
          isValidId(mediaId) &&
          isValidMediaAttachment(incoming(), patientId, mediaId) &&
          incoming().ownerUid == request.auth.uid &&
          incoming().serverCreatedAt == request.time &&
          incoming().serverUpdatedAt == request.time &&
          exists(/databases/$(database)/documents/patients/$(patientId)) &&
          (
            isSuperAdmin() ||
            isStaffAdmin() ||
            get(/databases/$(database)/documents/patients/$(patientId)).data.ownerUid == request.auth.uid ||
            isSharedTeamMember(get(/databases/$(database)/documents/patients/$(patientId)).data)
          );
        allow update: if isSignedIn() &&
          isValidId(patientId) &&
          isValidId(mediaId) &&
          isValidMediaAttachment(incoming(), patientId, mediaId) &&
          incoming().serverUpdatedAt == request.time &&
          (isSuperAdmin() || (
            (!('id' in existing()) || incoming().id == existing().id) &&
            (!('parentId' in existing()) || incoming().parentId == existing().parentId) &&
            (!('ownerUid' in existing()) ? incoming().ownerUid == request.auth.uid : incoming().ownerUid == existing().ownerUid) &&
            (!('serverCreatedAt' in existing()) || existing().serverCreatedAt == null || !(existing().serverCreatedAt is timestamp) ? incoming().serverCreatedAt == request.time : incoming().serverCreatedAt == existing().serverCreatedAt) &&
            (isStaffAdmin() || isOwner(existing()) || isSharedTeamMember(existing())) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'category', 'caption', 'title', 'dataUrl', 'fileName', 'fileType', 'fileSize', 'timestamp', 'uploadDate', 'serverUpdatedAt'
            ])
          ));
        allow delete: if isValidId(patientId) && isValidId(mediaId) && (isSuperAdmin() || isStaffAdmin() || isOwner(existing()) || isSharedTeamMember(existing()));
      }
    }

    // 6. Funeral Assistance Records (แบบ ฌศ.01)
    function isValidFuneralRecord(data, funeralId) {
      let keys = data.keys().toSet();
      return keys.hasAll([
          'id', 'ownerUid', 'code', 'status', 'deceasedName', 'applicantName',
          'createdAt', 'updatedAt', 'serverCreatedAt', 'serverUpdatedAt'
        ].toSet()) &&
        keys.hasOnly([
          'id', 'ownerUid', 'authorizedEmails', 'code', 'applicationDate', 'status', 'statusNote',
          'deceasedName', 'applicantName',
          'deceasedInfo', 'applicantInfo', 'cremationAid', 'signatories',
          'createdAt', 'updatedAt', 'serverCreatedAt', 'serverUpdatedAt'
        ].toSet()) &&
        isValidId(data.id) &&
        data.id == funeralId &&
        isValidId(data.ownerUid) &&
        isValidEmailList(data) &&
        data.code is string && data.code.size() >= 1 && data.code.size() <= 40 &&
        (!('applicationDate' in data) || (data.applicationDate is string && data.applicationDate.size() <= 32)) &&
        data.status in ['pending', 'approved', 'completed', 'rejected'] &&
        (!('statusNote' in data) || (data.statusNote is string && data.statusNote.size() <= 1000)) &&
        data.deceasedName is string && data.deceasedName.size() >= 1 && data.deceasedName.size() <= 200 &&
        data.applicantName is string && data.applicantName.size() >= 1 && data.applicantName.size() <= 200 &&
        (!('deceasedInfo' in data) || (
          data.deceasedInfo is map &&
          data.deceasedInfo.keys().size() <= 10 &&
          (!('deceasedAge' in data.deceasedInfo) || data.deceasedInfo.deceasedAge is number) &&
          (!('deceasedAddress' in data.deceasedInfo) || (data.deceasedInfo.deceasedAddress is string && data.deceasedInfo.deceasedAddress.size() <= 500)) &&
          (!('causeOfDeath' in data.deceasedInfo) || (data.deceasedInfo.causeOfDeath is string && data.deceasedInfo.causeOfDeath.size() <= 500))
        )) &&
        (!('applicantInfo' in data) || (
          data.applicantInfo is map &&
          data.applicantInfo.keys().size() <= 8 &&
          (!('applicantAddress' in data.applicantInfo) || (data.applicantInfo.applicantAddress is string && data.applicantInfo.applicantAddress.size() <= 500)) &&
          (!('applicantPovertyReason' in data.applicantInfo) || (data.applicantInfo.applicantPovertyReason is string && data.applicantInfo.applicantPovertyReason.size() <= 1000))
        )) &&
        (!('cremationAid' in data) || (
          data.cremationAid is map &&
          data.cremationAid.keys().size() <= 10 &&
          (!('assistanceAmount' in data.cremationAid) || data.cremationAid.assistanceAmount is number) &&
          (!('coffinProvided' in data.cremationAid) || data.cremationAid.coffinProvided is bool) &&
          (!('transportProvided' in data.cremationAid) || data.cremationAid.transportProvided is bool) &&
          (!('shroudClothProvided' in data.cremationAid) || data.cremationAid.shroudClothProvided is bool) &&
          (!('otherItems' in data.cremationAid) || (data.cremationAid.otherItems is string && data.cremationAid.otherItems.size() <= 500))
        )) &&
        (!('signatories' in data) || (
          data.signatories is map &&
          data.signatories.keys().size() <= 8
        )) &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64 &&
        data.serverCreatedAt is timestamp &&
        data.serverUpdatedAt is timestamp;
    }

    match /funerals/{funeralId} {
      allow get: if isValidId(funeralId) && (isStaffAdmin() || (resource == null && isAuthorizedStaff()) || (resource != null && (isOwner(existing()) || isSharedTeamMember(existing()))));
      allow list: if isSignedIn() && (hasBuiltInStaffEmail() || existing().ownerUid == request.auth.uid || isSharedTeamMember(existing()));
      allow create: if isSignedIn() &&
        isValidId(funeralId) &&
        isValidFuneralRecord(incoming(), funeralId) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().serverCreatedAt == request.time &&
        incoming().serverUpdatedAt == request.time &&
        isAuthorizedStaff();
      allow update: if isSignedIn() &&
        isValidId(funeralId) &&
        isValidFuneralRecord(incoming(), funeralId) &&
        incoming().serverUpdatedAt == request.time &&
        (
          hasSuperAdminEmail() ||
          (
            (!('id' in existing()) || incoming().id == existing().id) &&
            (!('ownerUid' in existing()) ? incoming().ownerUid == request.auth.uid : incoming().ownerUid == existing().ownerUid) &&
            (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
            (!('serverCreatedAt' in existing()) || existing().serverCreatedAt == null || !(existing().serverCreatedAt is timestamp) ? incoming().serverCreatedAt == request.time : incoming().serverCreatedAt == existing().serverCreatedAt) &&
            (isStaffAdmin() || (!(existing().status in ['completed', 'rejected']) && (isOwner(existing()) || isSharedTeamMember(existing())) && exists(/databases/$(database)/documents/settings/workspace) && isSharedTeamMember(get(/databases/$(database)/documents/settings/workspace).data))) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'code', 'applicationDate', 'status', 'statusNote',
              'deceasedName', 'applicantName',
              'deceasedInfo', 'applicantInfo', 'cremationAid', 'signatories',
              'updatedAt', 'serverUpdatedAt'
            ])
          )
        );
      allow delete: if isValidId(funeralId) && (isStaffAdmin() || isOwner(existing()) || isSharedTeamMember(existing()));

      match /media/{mediaId} {
        allow get: if isValidId(funeralId) && isValidId(mediaId) && (
          isStaffAdmin() ||
          (resource == null && isAuthorizedStaff()) ||
          (resource != null && (isOwner(existing()) || isSharedTeamMember(existing())))
        );
        allow list: if isSignedIn() && (isSuperAdmin() || isBuiltInStaffEmail() || existing().ownerUid == request.auth.uid || isSharedTeamMember(existing()));
        allow create: if isSignedIn() &&
          isValidId(funeralId) &&
          isValidId(mediaId) &&
          isValidMediaAttachment(incoming(), funeralId, mediaId) &&
          incoming().ownerUid == request.auth.uid &&
          incoming().serverCreatedAt == request.time &&
          incoming().serverUpdatedAt == request.time &&
          exists(/databases/$(database)/documents/funerals/$(funeralId)) &&
          (
            isSuperAdmin() ||
            isStaffAdmin() ||
            get(/databases/$(database)/documents/funerals/$(funeralId)).data.ownerUid == request.auth.uid ||
            isSharedTeamMember(get(/databases/$(database)/documents/funerals/$(funeralId)).data)
          );
        allow update: if isSignedIn() &&
          isValidId(funeralId) &&
          isValidId(mediaId) &&
          isValidMediaAttachment(incoming(), funeralId, mediaId) &&
          incoming().serverUpdatedAt == request.time &&
          (isSuperAdmin() || (
            (!('id' in existing()) || incoming().id == existing().id) &&
            (!('parentId' in existing()) || incoming().parentId == existing().parentId) &&
            (!('ownerUid' in existing()) ? incoming().ownerUid == request.auth.uid : incoming().ownerUid == existing().ownerUid) &&
            (!('serverCreatedAt' in existing()) || existing().serverCreatedAt == null || !(existing().serverCreatedAt is timestamp) ? incoming().serverCreatedAt == request.time : incoming().serverCreatedAt == existing().serverCreatedAt) &&
            (isStaffAdmin() || isOwner(existing()) || isSharedTeamMember(existing())) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'category', 'caption', 'title', 'dataUrl', 'fileName', 'fileType', 'fileSize', 'timestamp', 'uploadDate', 'serverUpdatedAt'
            ])
          ));
        allow delete: if isValidId(funeralId) && isValidId(mediaId) && (isSuperAdmin() || isStaffAdmin() || isOwner(existing()) || isSharedTeamMember(existing()));
      }
    }

    // 7. Donation Records (แบบ บจ.01)
    function isValidDonationRecord(data, donationId) {
      let keys = data.keys().toSet();
      return keys.hasAll([
          'id', 'ownerUid', 'code', 'status', 'recipientType',
          'createdAt', 'updatedAt', 'serverCreatedAt', 'serverUpdatedAt'
        ].toSet()) &&
        keys.hasOnly([
          'id', 'ownerUid', 'authorizedEmails', 'code', 'distributionDate', 'status', 'recipientType',
          'recipientInfo', 'itemsSummary', 'handoverAndSignatories',
          'createdAt', 'updatedAt', 'serverCreatedAt', 'serverUpdatedAt'
        ].toSet()) &&
        isValidId(data.id) &&
        data.id == donationId &&
        isValidId(data.ownerUid) &&
        isValidEmailList(data) &&
        data.code is string && data.code.size() >= 1 && data.code.size() <= 40 &&
        (!('distributionDate' in data) || (data.distributionDate is string && data.distributionDate.size() <= 32)) &&
        data.status in ['completed', 'pending', 'cancelled'] &&
        data.recipientType in ['individual', 'government'] &&
        (!('recipientInfo' in data) || (
          data.recipientInfo is map &&
          data.recipientInfo.keys().size() <= 18 &&
          (!('individualName' in data.recipientInfo) || (data.recipientInfo.individualName is string && data.recipientInfo.individualName.size() <= 200)) &&
          (!('individualNeedReason' in data.recipientInfo) || (data.recipientInfo.individualNeedReason is string && data.recipientInfo.individualNeedReason.size() <= 1000)) &&
          (!('agencyName' in data.recipientInfo) || (data.recipientInfo.agencyName is string && data.recipientInfo.agencyName.size() <= 300)) &&
          (!('agencyRequestPurpose' in data.recipientInfo) || (data.recipientInfo.agencyRequestPurpose is string && data.recipientInfo.agencyRequestPurpose.size() <= 1000))
        )) &&
        (!('itemsSummary' in data) || (
          data.itemsSummary is map &&
          data.itemsSummary.keys().size() <= 12 &&
          (!('waterPacks' in data.itemsSummary) || data.itemsSummary.waterPacks is number) &&
          (!('dryFoodCount' in data.itemsSummary) || data.itemsSummary.dryFoodCount is number) &&
          (!('riceBags' in data.itemsSummary) || data.itemsSummary.riceBags is number) &&
          (!('riceKg' in data.itemsSummary) || data.itemsSummary.riceKg is number) &&
          (!('diaperPacks' in data.itemsSummary) || data.itemsSummary.diaperPacks is number) &&
          (!('otherItems' in data.itemsSummary) || (data.itemsSummary.otherItems is list && data.itemsSummary.otherItems.size() <= 30)) &&
          (!('notes' in data.itemsSummary) || (data.itemsSummary.notes is string && data.itemsSummary.notes.size() <= 1000))
        )) &&
        (!('handoverAndSignatories' in data) || (
          data.handoverAndSignatories is map &&
          data.handoverAndSignatories.keys().size() <= 8
        )) &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64 &&
        data.serverCreatedAt is timestamp &&
        data.serverUpdatedAt is timestamp;
    }

    match /donations/{donationId} {
      allow get: if isValidId(donationId) && (isStaffAdmin() || (resource == null && isAuthorizedStaff()) || (resource != null && (isOwner(existing()) || isSharedTeamMember(existing()))));
      allow list: if isSignedIn() && (hasBuiltInStaffEmail() || existing().ownerUid == request.auth.uid || isSharedTeamMember(existing()));
      allow create: if isSignedIn() &&
        isValidId(donationId) &&
        isValidDonationRecord(incoming(), donationId) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().serverCreatedAt == request.time &&
        incoming().serverUpdatedAt == request.time &&
        isAuthorizedStaff();
      allow update: if isSignedIn() &&
        isValidId(donationId) &&
        isValidDonationRecord(incoming(), donationId) &&
        incoming().serverUpdatedAt == request.time &&
        (
          hasSuperAdminEmail() ||
          (
            (!('id' in existing()) || incoming().id == existing().id) &&
            (!('ownerUid' in existing()) ? incoming().ownerUid == request.auth.uid : incoming().ownerUid == existing().ownerUid) &&
            (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
            (!('serverCreatedAt' in existing()) || existing().serverCreatedAt == null || !(existing().serverCreatedAt is timestamp) ? incoming().serverCreatedAt == request.time : incoming().serverCreatedAt == existing().serverCreatedAt) &&
            (isStaffAdmin() || (existing().status != 'cancelled' && (isOwner(existing()) || isSharedTeamMember(existing())) && exists(/databases/$(database)/documents/settings/workspace) && isSharedTeamMember(get(/databases/$(database)/documents/settings/workspace).data))) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'code', 'distributionDate', 'status', 'recipientType',
              'recipientInfo', 'itemsSummary', 'handoverAndSignatories',
              'updatedAt', 'serverUpdatedAt'
            ])
          )
        );
      allow delete: if isValidId(donationId) && (isStaffAdmin() || isOwner(existing()) || isSharedTeamMember(existing()));

      match /media/{mediaId} {
        allow get: if isValidId(donationId) && isValidId(mediaId) && (
          isStaffAdmin() ||
          (resource == null && isAuthorizedStaff()) ||
          (resource != null && (isOwner(existing()) || isSharedTeamMember(existing())))
        );
        allow list: if isSignedIn() && (isSuperAdmin() || isBuiltInStaffEmail() || existing().ownerUid == request.auth.uid || isSharedTeamMember(existing()));
        allow create: if isSignedIn() &&
          isValidId(donationId) &&
          isValidId(mediaId) &&
          isValidMediaAttachment(incoming(), donationId, mediaId) &&
          incoming().ownerUid == request.auth.uid &&
          incoming().serverCreatedAt == request.time &&
          incoming().serverUpdatedAt == request.time &&
          exists(/databases/$(database)/documents/donations/$(donationId)) &&
          (
            isSuperAdmin() ||
            isStaffAdmin() ||
            get(/databases/$(database)/documents/donations/$(donationId)).data.ownerUid == request.auth.uid ||
            isSharedTeamMember(get(/databases/$(database)/documents/donations/$(donationId)).data)
          );
        allow update: if isSignedIn() &&
          isValidId(donationId) &&
          isValidId(mediaId) &&
          isValidMediaAttachment(incoming(), donationId, mediaId) &&
          incoming().serverUpdatedAt == request.time &&
          (isSuperAdmin() || (
            (!('id' in existing()) || incoming().id == existing().id) &&
            (!('parentId' in existing()) || incoming().parentId == existing().parentId) &&
            (!('ownerUid' in existing()) ? incoming().ownerUid == request.auth.uid : incoming().ownerUid == existing().ownerUid) &&
            (!('serverCreatedAt' in existing()) || existing().serverCreatedAt == null || !(existing().serverCreatedAt is timestamp) ? incoming().serverCreatedAt == request.time : incoming().serverCreatedAt == existing().serverCreatedAt) &&
            (isStaffAdmin() || isOwner(existing()) || isSharedTeamMember(existing())) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'category', 'caption', 'title', 'dataUrl', 'fileName', 'fileType', 'fileSize', 'timestamp', 'uploadDate', 'serverUpdatedAt'
            ])
          ));
        allow delete: if isValidId(donationId) && isValidId(mediaId) && (isSuperAdmin() || isStaffAdmin() || isOwner(existing()) || isSharedTeamMember(existing()));
      }
    }
  }
}
